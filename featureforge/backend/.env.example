# Copy this file to .env (which is gitignored) and fill in your real key.
# Get a free key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default model.
# ANTHROPIC_MODEL=claude-sonnet-5

# Any long random string — this signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing login token.
JWT_SECRET=replace-with-a-long-random-string

# Where Prisma stores data. The test suite overrides this to its own file
# automatically — you never need to touch that.
DATABASE_URL=file:./dev.db

# Optional. Leave unset for local dev (CORS stays wide open, which is fine
# since only you can reach localhost:4000). In production, set this to the
# real deployed frontend's URL so only it can call this API from a browser.
# CORS_ORIGIN=https://your-frontend.onrender.com
